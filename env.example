# =============================================================================
# SIMPLIFICAPSI - CONFIGURAÇÕES DE AMBIENTE
# =============================================================================

# =============================================================================
# AMBIENTE
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# =============================================================================
# BANCO DE DADOS
# =============================================================================
DATABASE_URL=postgresql://simplificapsi:simplificapsi123@localhost:5433/simplificapsi_dev
DATABASE_URL_TEST=postgresql://simplificapsi:simplificapsi123@localhost:5433/simplificapsi_test

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6380/0
REDIS_SESSION_DB=1
REDIS_CACHE_DB=2

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000

# =============================================================================
# OPENROUTER (fallback provider for LLM)
# =============================================================================
OPENROUTER_API_KEY=

# =============================================================================
# AGENT
# =============================================================================
SIMPLIFICA_AGENT_MODEL=gpt-5.4-mini
TIMEZONE=America/Sao_Paulo

# =============================================================================
# GOOGLE CALENDAR
# =============================================================================
# Auth dual-mode. PADRÃO (fricção zero) = Service Account: cria um calendário
# por profissional sob a SA e compartilha best-effort com o e-mail dele.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Upgrade OPCIONAL = OAuth por-usuário (agenda pessoal do profissional). Tem
# prioridade quando o usuário conecta via scripts/google_auth.py.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SCOPES=["https://www.googleapis.com/auth/calendar"]

# =============================================================================
# WHATSAPP BUSINESS API
# =============================================================================
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# =============================================================================
# EVOLUTION API (provedor WhatsApp default — usado pelo compose de dev)
# =============================================================================
# Defaults batem com docker-compose.yml (serviço `evolution`). Para dev local
# (make run), a app fala com o Evolution em localhost:8080. Se rodar a app dentro
# do compose, use http://evolution:8080.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution-dev-key
EVOLUTION_INSTANCE=simplificapsi
# Opcional: se setado, o webhook /webhooks/evolution exige este token no header
# X-Webhook-Token. Deixe vazio para o compose de dev (webhook global do Evolution
# não envia header customizado).
EVOLUTION_WEBHOOK_TOKEN=

# =============================================================================
# SEGURANÇA
# =============================================================================
SECRET_KEY=your_secret_key_here_change_in_production
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# LOGGING
# =============================================================================
LOG_FORMAT=json
LOG_FILE=logs/simplificapsi.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# MONITORAMENTO
# =============================================================================
SENTRY_DSN=your_sentry_dsn_here
HEALTH_CHECK_INTERVAL=30

# =============================================================================
# DESENVOLVIMENTO
# =============================================================================
RELOAD=true
WORKERS=1
HOST=0.0.0.0
PORT=8000

# =============================================================================
# TESTES
# =============================================================================
TESTING=false
# (test DB/redis URLs use DATABASE_URL_TEST above; no separate TEST_* keys)
